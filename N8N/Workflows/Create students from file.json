      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Get all input items (Excel rows parsed by n8n)\nconst items = $input.all();\n\n// The first row contains headers\nconst headers = items[0].json.row;\n\n// Array to store the result\nconst result = [];\n\n// Loop through each row (skip the first header row)\nfor (let i = 1; i < items.length; i++) {\n  const row = items[i].json.row;\n  const obj = {};\n\n  // Map each column value to its header\n  headers.forEach((header, index) => {\n    obj[header] = row[index];\n  });\n\n  result.push(obj);\n}\n\n// Convert the result array to a pretty JSON string\nconst allData = JSON.stringify(result, null, 2);\n\n// Return the string as output\nreturn [{ json: { allData } }];\n"
      },
